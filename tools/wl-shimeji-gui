}


def normalize_ie_mode(value):
    """Devuelve un valor de IE_MODES o None si no es reconocido."""
    if not value:
        return None
    return IE_MODE_ALIASES.get(str(value).strip().lower())


def read_umbriel_ie_mode():
    """Lee `ie_mode` del archivo de ajustes del plugin, si existe."""
    try:
        text = UMBRIEL_IE_CONF.read_text(encoding='utf-8')
    except OSError:
        return None
    for line in text.splitlines():
        line = line.split('#', 1)[0].strip()
        if '=' not in line:
            continue
        key, value = line.split('=', 1)
        if key.strip().lower() in ('ie_mode', 'umbriel_ie_mode'):
            mode = normalize_ie_mode(value)
            if mode:
                return mode
    return None


def effective_ie_mode():
    """Modo que verá el plugin: entorno > archivo > valor por defecto."""
    env_mode = normalize_ie_mode(os.environ.get('UMBRIEL_IE_MODE'))
    return env_mode or read_umbriel_ie_mode() or 'active'


def save_umbriel_ie_mode(mode):
    """Guarda el modo y lo exporta para los overlays que lance esta GUI."""
    mode = normalize_ie_mode(mode) or 'active'
    UMBRIEL_IE_CONF.parent.mkdir(parents=True, exist_ok=True)
    lines = [
        '# UmbrielSupport: ventana en la que las mascotas pueden pararse.',
        '# active | focused | largest | none',
        f'ie_mode={mode}',
    ]
    UMBRIEL_IE_CONF.write_text('\n'.join(lines) + '\n', encoding='utf-8')
    os.environ['UMBRIEL_IE_MODE'] = mode


def run_ctl_sync(*args, input_str=None, timeout=12):
    """
    Ejecuta shimejictl mediante un pseudo-terminal (PTY).
    Esto evita que `shimejictl` falle en `os.get_terminal_size()`
    cuando se invoque sin un TTY adjunto.
    """
    master, slave = pty.openpty()
    os.set_blocking(master, False)
    try:
        p = subprocess.Popen(
            ['shimejictl', *args],
            stdin=slave,
            stdout=slave,
            stderr=slave,
            close_fds=True
        )
        os.close(slave)
        if input_str:
            try:
                os.write(master, input_str.encode('utf-8'))
            except OSError:
                pass

        chunks = []
        while True:
            r, _, _ = select.select([master], [], [], 0.1)
            if r:
                try:
                    d = os.read(master, 4096)
                    if not d:
                        break
                    chunks.append(d)
                except OSError as e:
                    if e.errno in (errno.EAGAIN, errno.EWOULDBLOCK):
                        pass
                    elif e.errno in (errno.EIO, errno.EBADF):
                        break
                    else:
                        raise
            if p.poll() is not None:
                # El proceso ha terminado; vaciar los bytes restantes con lecturas no bloqueantes
                while True:
                    r2, _, _ = select.select([master], [], [], 0.02)
                    if not r2:
                        break
                    try:
                        d = os.read(master, 4096)
                        if not d:
                            break
                        chunks.append(d)
                    except OSError:
                        break
                break

        p.wait(timeout=timeout)
        output = b''.join(chunks).decode('utf-8', errors='replace')
        output = output.replace('\r\n', '\n').replace('\r', '\n')
        return p.returncode, output
    finally:
        try:
            os.close(master)
        except OSError:
            pass


class CtlAsyncWorker(QThread):
    """
    Hilo de trabajo no bloqueante para comandos que transmiten su salida o
    esperan clics interactivos en pantalla (p. ej. summon -s, dismiss --select, convert).
    """
    output_received = Signal(str)
    command_finished = Signal(int, str)

    def __init__(self, args, input_str=None, timeout=120, parent=None):
        super().__init__(parent)
        self.args = list(args)
        self.input_str = input_str
        self.timeout = timeout
        self._proc = None
        self._master = None
        self._cancelled = False

    def cancel(self):
        self._cancelled = True
        if self._proc and self._proc.poll() is None:
            try:
                self._proc.terminate()
            except OSError:
                pass

    def run(self):
        master, slave = pty.openpty()
        os.set_blocking(master, False)
        self._master = master
        chunks = []
        try:
            p = subprocess.Popen(
                ['shimejictl', *self.args],
                stdin=slave,
                stdout=slave,
                stderr=slave,
                close_fds=True
            )
            self._proc = p
            os.close(slave)
            if self.input_str:
                try:
                    os.write(master, self.input_str.encode('utf-8'))
                except OSError:
                    pass

            while not self._cancelled:
                r, _, _ = select.select([master], [], [], 0.1)
                if r:
                    try:
                        d = os.read(master, 4096)
                        if not d:
                            break
                        text = d.decode('utf-8', errors='replace').replace('\r\n', '\n').replace('\r', '\n')
                        chunks.append(d)
                        self.output_received.emit(text)
                    except OSError as e:
                        if e.errno in (errno.EAGAIN, errno.EWOULDBLOCK):
                            pass
                        elif e.errno in (errno.EIO, errno.EBADF):
                            break
                        else:
                            raise
                if p.poll() is not None:
                    # Vaciar los bytes restantes usando select no bloqueante
                    while True:
                        r2, _, _ = select.select([master], [], [], 0.02)
                        if not r2:
                            break
                        try:
                            d = os.read(master, 4096)
                            if not d:
                                break
                            text = d.decode('utf-8', errors='replace').replace('\r\n', '\n').replace('\r', '\n')
                            chunks.append(d)
                            self.output_received.emit(text)
                        except OSError:
                            break
                    break

            if not self._cancelled:
                p.wait(timeout=self.timeout)
                returncode = p.returncode
            else:
                returncode = -1
                self.output_received.emit("\n[Operación cancelada por el usuario]\n")

            total_output = b''.join(chunks).decode('utf-8', errors='replace').replace('\r\n', '\n').replace('\r', '\n')
            self.command_finished.emit(returncode, total_output)
        except Exception as e:
            self.output_received.emit(f"\n[Error de ejecución: {e}]\n")
            self.command_finished.emit(1, str(e))
        finally:
            try:
                os.close(master)
            except OSError:
                pass
            self._master = None
            self._proc = None


def load_pixmap(file_path):
    """Carga un archivo de imagen (.qoi, .png, etc.) y devuelve un QPixmap."""
    if not file_path:
        return None
    file_path = Path(file_path)
    if not file_path.exists():
        return None

    cache_key = str(file_path.resolve())
    if cache_key in _PIXMAP_CACHE:
        return _PIXMAP_CACHE[cache_key]

    try:
        # PIL decodifica directamente QOI, PNG, WebP y JPEG
        im = Image.open(file_path).convert('RGBA')
        data = im.tobytes()
        qim = QImage(data, im.width, im.height, im.width * 4, QImage.Format.Format_RGBA8888)
        pix = QPixmap.fromImage(qim)
        if not pix.isNull():
            _PIXMAP_CACHE[cache_key] = pix
            return pix
    except Exception:
        pass

    # Alternativa: usar QPixmap directamente
    try:
        pix = QPixmap(str(file_path))
        if not pix.isNull():
            _PIXMAP_CACHE[cache_key] = pix
            return pix
    except Exception:
        pass
    return None


def find_preview(name):
    """
    Busca la imagen de vista previa de un prototipo.
    Admite archivos .qoi y .png, buscando primero en los directorios de wl_shimeji.
    """
    needles = [name.lower(), ('shimeji.' + name).lower()]
    # Ruta rápida: comprobar DATA / 'shimejis' y DATA / 'prototypes'
    priority_roots = [DATA / 'shimejis', DATA / 'prototypes', DATA]
    candidates = []

    for root in priority_roots:
        if not root.exists():
            continue
        try:
            for ext in ('*.qoi', '*.png', '*.webp'):
                for p in root.rglob(ext):
                    s = str(p).lower()
                    if any(n in s for n in needles):
                        candidates.append(p)
        except OSError:
            pass
        if candidates:
            break

    # Si todavía no se encuentra, buscar en CONFIG
    if not candidates and CONFIG.exists():
        try:
            for ext in ('*.qoi', '*.png', '*.webp'):
                for p in CONFIG.rglob(ext):
                    s = str(p).lower()
                    if any(n in s for n in needles):
                        candidates.append(p)
        except OSError:
            pass

    if not candidates:
        return None

    def score(p):
        n = p.name.lower()
        if n in ('shime1.qoi', 'shime1.png', 'idle_01.qoi', 'idle_01.png', 'stand_01.qoi', 'stand_01.png'):
            return (0, len(str(p)))
        return (1, len(str(p)))

    return sorted(candidates, key=score)[0]


def prototype_names(text):
    """Extrae nombres de prototipos limpios de la salida de `shimejictl prototypes list`."""
    names = []
    for line in text.splitlines():
        s = line.strip()
        if not s:
            continue
        s = re.sub(r'^[\\|`\-+*>\s]*\d+[.):]\s*', '', s)
        s = re.sub(r'^[\\|`\-+*>]\s*', '', s)
        low = s.lower()
        if s and not any(x in low for x in ['prototype', 'available', 'object id', 'end', 'id:', 'author:', 'version:']):
            names.append(s)
    return list(dict.fromkeys(names))


def parse_section(text, heading):
    """Analiza los elementos de una lista bajo un encabezado de `shimejictl prototypes info`."""
    values = []
    active = False
    for raw in text.splitlines():
        line = raw.strip()
        if line == heading + ':':
            active = True
            continue
        if not active:
            continue
        if re.match(r'^[A-Za-z][A-Za-z _-]*:\s*', line) or 'Object id:' in line or '[END]' in line:
            break
        m = re.match(r'^[-*]\s+(.+?)\s*$', line)
        if m:
            values.append(m.group(1).strip())
    return list(dict.fromkeys(values))


def filter_behaviors(name, raw_behaviors):
    """
    Filtra los marcadores de condición generados por el compilador (p. ej. ___CONDITION_0),
    las transiciones internas de pared (p. ej. LeaveWall) y los comportamientos
    ocultos o de condición.
    """
    b_json_paths = [
        DATA / 'shimejis' / f'Shimeji.{name}' / 'behaviors.json',
        DATA / 'shimejis' / name / 'behaviors.json',
        DATA / 'prototypes' / f'Shimeji.{name}' / 'behaviors.json',
        DATA / 'prototypes' / name / 'behaviors.json',
    ]
    defs_map = {}
    for p in b_json_paths:
        if p.exists():
            try:
                import json
                with open(p, 'r', encoding='utf-8') as f:
                    data = json.load(f)
                for item in data.get('definitions', []):
                    defs_map[item.get('name')] = item
                break
            except Exception:
                pass

    filtered = []
    for b in raw_behaviors:
        if not b:
            continue
        # Filtrar artefactos del compilador y manejadores internos de transición de pared
        if b.startswith('_') or 'condition' in b.lower() or b.lower() == 'leavewall':
            continue
        b_def = defs_map.get(b)
        if b_def and (b_def.get('hidden') or b_def.get('is_conditioner')):
            continue
        filtered.append(b)
    return filtered


def proto_info(name):
    """Obtiene los comportamientos, acciones y salida sin procesar de un prototipo."""
    rc, out = run_ctl_sync('prototypes', 'info', name)
    behaviors = parse_section(out, 'Behaviors') if rc == 0 else []
    actions = parse_section(out, 'Actions') if rc == 0 else []
    clean_behaviors = filter_behaviors(name, behaviors)
    return clean_behaviors, actions, out


def prototype_store_path(info):
    """Extrae 'Prototype store path: ...' del texto de información."""
    m = re.search(r'^\s*Prototype store path:\s*(.+?)\s*$', info, re.M)
    return m.group(1).strip() if m else ''


def parse_environments(text):
    """Analiza los entornos de la salida de `shimejictl environment list`."""
    envs = []
    pattern = re.compile(
        r'Environment\(\s*id=(?P<id>\d+)'
        r'(?:,\s*name=(?P<name>[^,]*))?'
        r'(?:,\s*description=(?P<desc>[^,]*))?'
        r'(?:,\s*pos=\((?P<x>-?\d+),(?P<y>-?\d+)\))?'
        r'(?:,\s*size=\((?P<w>\d+),(?P<h>\d+)\))?'
        r'(?:,\s*scale=(?P<scale>[\d.]+))?'
        r'(?:,\s*with\s+(?P<mascots>\d+)\s+mascots\))?'
    )
    for m in pattern.finditer(text):
        envs.append({
            'id': int(m.group('id')),
            'name': (m.group('name') or '').strip(),
            'description': (m.group('desc') or '').strip(),
            'pos': f"({m.group('x') or 0}, {m.group('y') or 0})",
            'size': f"{m.group('w') or '?'} x {m.group('h') or '?'}",
            'scale': f"{float(m.group('scale')):.2f}" if m.group('scale') else '1.00',
            'mascots': int(m.group('mascots') or 0)
        })
    return envs


class ConverterDialog(QDialog):
    """Diálogo específico para convertir instancias de Shimeji-EE al formato .wlshm."""
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setWindowTitle('Convertidor de Shimeji-EE a wl_shimeji')
        self.resize(600, 420)
        self.worker = None

        layout = QVBoxLayout(self)

        form = QFormLayout()
        self.src_edit = QLineEdit()
        src_row = QHBoxLayout()
        src_row.addWidget(self.src_edit)
        btn_src_zip = QPushButton('Seleccionar archivo ZIP')
        btn_src_dir = QPushButton('Seleccionar directorio descomprimido')
        src_row.addWidget(btn_src_zip)
        src_row.addWidget(btn_src_dir)
        form.addRow('Archivo/directorio de origen:', src_row)

        self.out_edit = QLineEdit(str(Path.home() / 'Downloads'))
        out_row = QHBoxLayout()
        out_row.addWidget(self.out_edit)
        btn_out_dir = QPushButton('Examinar...')
        out_row.addWidget(btn_out_dir)
        form.addRow('Directorio de salida:', out_row)

        self.force_check = QCheckBox('Sobrescribir archivos existentes (-f / --force)')
        self.force_check.setChecked(True)
        form.addRow('', self.force_check)

        self.auto_import = QCheckBox('Importar automáticamente a la biblioteca al terminar')
        self.auto_import.setChecked(True)
        form.addRow('', self.auto_import)

        layout.addLayout(form)

        self.log_box = QTextEdit()
        self.log_box.setReadOnly(True)
        self.log_box.setPlaceholderText('Registro de conversión...')
        layout.addWidget(self.log_box)

        btn_row = QHBoxLayout()
        self.btn_start = QPushButton('Iniciar conversión')
        self.btn_cancel = QPushButton('Cancelar')
        self.btn_close = QPushButton('Cerrar')
        btn_row.addStretch()
        btn_row.addWidget(self.btn_start)
        btn_row.addWidget(self.btn_cancel)
        btn_row.addWidget(self.btn_close)
        layout.addLayout(btn_row)

        btn_src_zip.clicked.connect(self.choose_zip)
        btn_src_dir.clicked.connect(self.choose_dir)
        btn_out_dir.clicked.connect(self.choose_out)
        self.btn_start.clicked.connect(self.start_conversion)
        self.btn_cancel.clicked.connect(self.cancel_conversion)
        self.btn_close.clicked.connect(self.accept)
        self.btn_cancel.setEnabled(False)

    def choose_zip(self):
        f, _ = QFileDialog.getOpenFileName(self, 'Seleccionar archivo ZIP de Shimeji-EE', str(HOME), 'Archivos ZIP (*.zip)')
        if f:
            self.src_edit.setText(f)

    def choose_dir(self):
        d = QFileDialog.getExistingDirectory(self, 'Seleccionar directorio descomprimido de Shimeji-EE', str(HOME))
        if d:
            self.src_edit.setText(d)

    def choose_out(self):
        d = QFileDialog.getExistingDirectory(self, 'Seleccionar directorio de salida', self.out_edit.text() or str(HOME))
        if d:
            self.out_edit.setText(d)

    def start_conversion(self):
        src = self.src_edit.text().strip()
        out = self.out_edit.text().strip()
        if not src or not os.path.exists(src):
            QMessageBox.warning(self, 'Error', 'Selecciona un archivo ZIP o directorio de origen válido.')
            return
        if not out:
            QMessageBox.warning(self, 'Error', 'Especifica un directorio de salida.')
            return
        os.makedirs(out, exist_ok=True)

        args = ['convert', src, '-O', out]
        if self.force_check.isChecked():
            args.append('-f')

        self.log_box.append(f"$ shimejictl {' '.join(args)}\n")
        self.btn_start.setEnabled(False)
        self.btn_cancel.setEnabled(True)

        # Enviar 'A\n' para convertir todos los prototipos si se solicita
        self.worker = CtlAsyncWorker(args, input_str='A\n', parent=self)
        self.worker.output_received.connect(self.log_box.append)
        self.worker.command_finished.connect(self.on_conversion_finished)
        self.worker.start()

    def cancel_conversion(self):
        if self.worker:
            self.worker.cancel()

    def on_conversion_finished(self, rc, out):
        self.btn_start.setEnabled(True)
        self.btn_cancel.setEnabled(False)
        if rc == 0:
            out_dir = Path(self.out_edit.text().strip())
            converted_files = sorted(str(p) for p in out_dir.glob('*.wlshm'))
            self.log_box.append(f"\n¡Conversión completada! El directorio de salida contiene {len(converted_files)} archivos .wlshm.\n")
            if self.auto_import.isChecked() and converted_files:
                import_rc, import_out = run_ctl_sync('prototypes', 'import', '-f', *converted_files)
                self.log_box.append(f"$ shimejictl prototypes import -f ...\n{import_out}\n")
                if import_rc == 0:
                    QMessageBox.information(self, 'Completado', f'Se han convertido e importado correctamente {len(converted_files)} personajes.')
                    if self.parent() and hasattr(self.parent(), 'refresh'):
                        self.parent().refresh()
                else:
                    QMessageBox.warning(self, 'Aviso', f'La conversión se realizó correctamente, pero se produjo un error al importar los personajes:\n{import_out[:1000]}')
            else:
                QMessageBox.information(self, 'Completado', 'Conversión completada.')
        else:
            QMessageBox.warning(self, 'Error de conversión', f'La conversión devolvió el código de error {rc}. Consulta el registro.')


class SettingsDialog(QDialog):
