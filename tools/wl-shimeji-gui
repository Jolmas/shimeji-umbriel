    def log(self, text):
        self.log_console.append(text.rstrip())

    def run_async(self, args, status_msg='Ejecutando comando...', callback=None):
        """Ejecuta un comando de shimejictl de forma asíncrona con registro en directo."""
        if self.current_worker and self.current_worker.isRunning():
            QMessageBox.warning(self, 'Aviso', 'El comando anterior todavía está en curso; espera a que termine o pulsa «Interrumpir comando actual».')
            return

        self.status_label.setText(status_msg)
        self.btn_cancel_worker.setEnabled(True)
        self.log(f"$ shimejictl {' '.join(str(x) for x in args)}")

        self.current_worker = CtlAsyncWorker(args, parent=self)
        self.current_worker.output_received.connect(self.log)

        def on_done(rc, out):
            self.btn_cancel_worker.setEnabled(False)
            self.current_worker = None
            if rc == 0:
                self.status_label.setText('Comando completado (código de retorno: 0)')
                if not out.strip():
                    self.log("[Comando finalizado]\n")
            else:
                self.status_label.setText(f'Error al ejecutar el comando (código de retorno: {rc})')
            if callback:
                callback(rc, out)
            self.refresh_environments()

        self.current_worker.command_finished.connect(on_done)
        self.current_worker.start()

    def cancel_current_command(self):
        if self.current_worker:
            self.current_worker.cancel()
            self.current_worker = None
            self.btn_cancel_worker.setEnabled(False)
            self.status_label.setText('Se ha solicitado interrumpir el comando actual')

    def current_prototype_name(self):
        item = self.proto_list.currentItem()
        return item.data(Qt.UserRole) if item else ''

    def refresh(self):
        """Obtiene los nombres de los prototipos y rellena la lista con vistas previas."""
        rc, out = run_ctl_sync('prototypes', 'list')
        self.proto_list.clear()
        self.names = []

        if rc != 0:
            self.status_label.setText('No se pudo conectar ni leer la lista de personajes; comprueba que shimejictl esté instalado.')
            self.log(f"No se pudieron leer los personajes:\n{out}")
            return

        self.names = prototype_names(out)
        filter_text = self.search_input.text().strip().lower()

        for name in self.names:
            item = QListWidgetItem(name)
            item.setData(Qt.UserRole, name)
            preview_path = find_preview(name)
            pix = load_pixmap(preview_path)
            if pix:
                item.setIcon(QIcon(pix))
            else:
                item.setIcon(QIcon.fromTheme('applications-games'))

            if not filter_text or filter_text in name.lower():
                item.setHidden(False)
            else:
                item.setHidden(True)
            self.proto_list.addItem(item)

        if self.proto_list.count() > 0:
            for i in range(self.proto_list.count()):
                if not self.proto_list.item(i).isHidden():
                    self.proto_list.setCurrentRow(i)
                    break

        self.status_label.setText(f'Se han cargado {len(self.names)} prototipos de personajes')
        self.rebuild_tray()

    def filter_prototypes(self, text):
        text = text.strip().lower()
        for i in range(self.proto_list.count()):
            item = self.proto_list.item(i)
            name = item.data(Qt.UserRole) or ''
            item.setHidden(bool(text and text not in name.lower()))

    def on_proto_selected(self, item, *args):
        self.beh_combo.clear()
        self.beh_combo.addItem('(Comportamiento predeterminado)', '')

        if not item:
            self.role_title.setText('Ningún personaje seleccionado')
            self.role_meta.setText('')
            self.preview_label.setPixmap(QPixmap())
            self.preview_label.setText('Selecciona un personaje')
            self.inspect_text.clear()
            return

        name = item.data(Qt.UserRole)
        self.role_title.setText(name)

        behaviors, actions, raw_info = proto_info(name)
        for b in behaviors:
            self.beh_combo.addItem(b, b)

        author_m = re.search(r'^\s*Author:\s*(.*?)$', raw_info, re.M)
        ver_m = re.search(r'^\s*Version:\s*(.*?)$', raw_info, re.M)
        author = author_m.group(1).strip() if author_m else ''
        version = ver_m.group(1).strip() if ver_m else '0'

        meta_parts = []
        if author:
            meta_parts.append(f"Autor: {author}")
        if version:
            meta_parts.append(f"Versión: {version}")
        meta_parts.append(f"Acciones: {len(actions)}")
        meta_parts.append(f"Comportamientos: {len(behaviors)}")
        self.role_meta.setText(' | '.join(meta_parts))

        # Actualizar la etiqueta de vista previa
        preview_path = find_preview(name)
        pix = load_pixmap(preview_path)
        if pix:
            self.preview_label.setText('')
            self.preview_label.setPixmap(
                pix.scaled(200, 180, Qt.KeepAspectRatio, Qt.SmoothTransformation)
            )
        else:
            self.preview_label.setPixmap(QPixmap())
            self.preview_label.setText(f"{name}\n\n(No se encontró vista previa local)")

        # Actualizar la pestaña de detalles
        inspect_lines = [
            f"=== Prototipo de personaje: {name} ===",
            f"Autor: {author or '(ninguno)'}",
            f"Versión: {version}",
            f"Ruta de almacenamiento: {prototype_store_path(raw_info) or '(no disponible)'}",
            f"\n--- Acciones disponibles ({len(actions)}) ---",
        ]
        for a in actions:
            inspect_lines.append(f"  • {a}")
        inspect_lines.append(f"\n--- Comportamientos disponibles ({len(behaviors)}) ---")
        for b in behaviors:
            inspect_lines.append(f"  • {b}")
        inspect_lines.append("\n--- Información sin procesar (shimejictl prototypes info) ---")
        inspect_lines.append(raw_info)
        self.inspect_text.setPlainText('\n'.join(inspect_lines))

    def summon(self, select=False):
        name = self.current_prototype_name()
        if not name:
            QMessageBox.information(self, 'Aviso', 'Selecciona primero un personaje en el panel izquierdo.')
            return

        count = self.summon_count.value()
        behavior = self.beh_combo.currentData() or ''
        env_id = self.summon_env_combo.currentData()
        x_val = self.pos_x.value()
        y_val = self.pos_y.value()

        base_args = ['mascot', 'summon']
        if select:
            base_args.append('-s')
        if behavior:
            base_args.extend(['-b', behavior])
        if env_id:
            base_args.extend(['-e', str(env_id)])

        if not select:
            if x_val >= 0 and y_val >= 0:
                base_args.extend(['--position', f'{x_val},{y_val}'])
            elif x_val >= 0:
                base_args.extend(['-x', str(x_val)])
            elif y_val >= 0:
                base_args.extend(['-y', str(y_val)])

        base_args.append(name)

        if select or count == 1:
            self.run_async(base_args, 'Haz clic en la pantalla en el lugar donde quieres invocar al personaje...' if select else 'Invocando al personaje...')
        else:
            # Invocación por lotes
            self.status_label.setText(f'Invocando {count} ejemplares de {name}...')
            self.log(f"Invocación por lotes: {count} × {name}...")

            def batch_thread():
                for i in range(count):
                    run_ctl_sync(*base_args)
                QTimer.singleShot(0, lambda: [
                    self.status_label.setText(f'Se han invocado {count} ejemplares de {name}'),
                    self.refresh_environments()
                ])

            threading.Thread(target=batch_thread, daemon=True).start()

    def dismiss_all(self):
        if QMessageBox.question(self, 'Confirmar', '¿Seguro que quieres eliminar todos los personajes de la pantalla?') == QMessageBox.Yes:
            self.run_async(['mascot', 'dismiss', '--all'], 'Eliminando todos los personajes...')

    def dismiss_by_id(self):
        mid = self.dismiss_id_input.text().strip()
        if not mid or not mid.isdigit():
            QMessageBox.warning(self, 'Error', 'Introduce un ID de personaje que contenga solo números.')
            return
        self.run_async(['mascot', 'dismiss', '-i', mid], f'Eliminando el personaje #{mid}...')

    def dismiss_by_env(self):
        env_id = self.summon_env_combo.currentData()
        if not env_id:
            # Intentar obtener la fila seleccionada de la tabla de entornos
            row = self.env_table.currentRow()
            if row >= 0:
                item = self.env_table.item(row, 0)
                if item:
                    env_id = item.text().strip()
        if not env_id:
            QMessageBox.information(self, 'Aviso', 'Selecciona primero una pantalla concreta en el desplegable «Pantalla de destino» o en la pestaña «Entornos de pantalla».')
            return
        self.run_async(['mascot', 'dismiss', '-e', str(env_id), '--all'], f'Eliminando todos los personajes de la pantalla #{env_id}...')

    def change_behavior_select(self):
        beh = self.beh_combo.currentData() or self.beh_combo.currentText()
        if not beh or beh == '(Comportamiento predeterminado)':
            QMessageBox.information(self, 'Aviso', 'Selecciona primero un comportamiento concreto en el desplegable «Comportamiento inicial».')
            return
        self.run_async(['mascot', 'set-behavior', beh], f'Haz clic en la pantalla en el personaje que quieres cambiar a «{beh}»...')

    def restore_windows(self):
        self.run_async(['restore-windows'], 'Restaurando las ventanas capturadas (restore-windows)...')

    def reload_all_prototypes(self):
        self.run_async(['prototypes', 'reload-all'], 'Enviando la señal de recarga de personajes al daemon...', callback=lambda rc, _: self.refresh())

    def add_role(self):
        f, _ = QFileDialog.getOpenFileName(
            self, 'Añadir personaje', str(HOME),
            'Personajes Shimeji (*.wlshm *.zip);;Paquetes de personajes wl_shimeji (*.wlshm);;ZIP de Shimeji-EE (*.zip);;Todos los archivos (*)'
        )
        if not f:
            return

        if f.lower().endswith('.wlshm'):
            self.run_async(['prototypes', 'import', '-f', f], f'Importando {Path(f).name}...', callback=lambda rc, _: self.refresh())
            return

        # Es un archivo ZIP: convertir en un directorio temporal y después importar
        with tempfile.TemporaryDirectory(prefix='wl-shimeji-gui-') as td:
            p = subprocess.run(['shimejictl', 'convert', f, '-O', td, '-f'], input='A\n', text=True, capture_output=True)
            out = (p.stdout or '') + (p.stderr or '')
            self.log(f"$ shimejictl convert {f} -O <temp> -f\n{out}")
            files = sorted(str(x) for x in Path(td).glob('*.wlshm'))
            if p.returncode or not files:
                QMessageBox.warning(self, 'Añadir personaje', 'La conversión ha fallado o no se han encontrado recursos válidos de Shimeji-EE en el ZIP.\n\n' + out[-2000:])
                return
            rc, imp_out = run_ctl_sync('prototypes', 'import', '-f', *files)
            self.log(f"$ shimejictl prototypes import -f ...\n{imp_out}")
            if rc == 0:
                self.refresh()
                QMessageBox.information(self, 'Correcto', f'¡Se han convertido e importado correctamente {len(files)} prototipos de personajes!')
            else:
                QMessageBox.warning(self, 'Error de importación', f'La conversión se completó, pero se produjo un error durante la importación:\n{imp_out}')

    def export_role(self):
        name = self.current_prototype_name()
        if not name:
            QMessageBox.information(self, 'Aviso', 'Selecciona primero en el panel izquierdo el personaje que quieres exportar.')
            return
        dest, _ = QFileDialog.getSaveFileName(
            self, f'Exportar personaje - {name}', str(HOME / f'Shimeji.{name}.wlshm'), 'Paquetes de personajes wl_shimeji (*.wlshm)'
        )
        if dest:
            self.run_async(['prototypes', 'export', '-i', name, '-o', dest, '-f'], f'Exportando {name} a {dest}...')

    def delete_role(self):
        name = self.current_prototype_name()
        if not name:
            return
        if QMessageBox.question(self, 'Eliminar personaje', f'¿Seguro que quieres eliminar definitivamente «{name}» de la biblioteca de wl_shimeji?\n\nNota: esto no afecta a los archivos ZIP ni .wlshm que descargaste originalmente.') != QMessageBox.Yes:
            return

        # Comprobar si existe el comando nativo de eliminación
        rc, helpout = run_ctl_sync('prototypes', '--help')
        for verb in ('remove', 'delete'):
            if re.search(rf'(?<![\w-]){verb}(?![\w-])', helpout):
                self.run_async(['prototypes', verb, name], f'Eliminando {name}...', callback=lambda rc, _: self.refresh())
                return

        # Alternativa: eliminar mediante la ruta de almacenamiento
        behaviors, actions, info = proto_info(name)
        rel = prototype_store_path(info)
        if not rel:
            QMessageBox.warning(self, 'Eliminar personaje', 'No se pudo interpretar la ruta de almacenamiento del prototipo de este personaje.')
            return

        # Ubicaciones de destino posibles
        target = None
        for base in [DATA / 'shimejis', DATA / 'prototypes', DATA]:
            candidate = (base / rel).resolve()
            if candidate.exists():
                target = candidate
                break

        if not target or not target.exists():
            QMessageBox.warning(self, 'Eliminar personaje', f'No se encontró la carpeta de almacenamiento del personaje en el directorio local de datos:\n{rel}')
            return

        # Comprobación de seguridad: debe estar dentro de ~/.local/share/wl_shimeji
        try:
            target.relative_to(DATA.resolve())
        except ValueError:
            QMessageBox.critical(self, 'Restricción de seguridad', 'Eliminación denegada: la ruta no está dentro del directorio exclusivo de wl_shimeji.')
            return

        try:
            if target.is_dir():
                shutil.rmtree(target)
            else:
                target.unlink()
            self.log(f"Se ha limpiado el directorio de almacenamiento: {target}")
            # Recarga en caliente o detención de la capa para liberar referencias en memoria
            run_ctl_sync('prototypes', 'reload-all')
            self.refresh()
            QMessageBox.information(self, 'Eliminar personaje', f'El personaje «{name}» se ha eliminado correctamente.')
        except OSError as e:
            QMessageBox.critical(self, 'Error al eliminar el personaje', f"Error en la operación del sistema de archivos: {e}")

    def refresh_environments(self):
        """Consulta `shimejictl environment list` y actualiza la tabla y los desplegables."""
        rc, out = run_ctl_sync('environment', 'list')
        if rc != 0:
            return

        self.environments = parse_environments(out)
        self.env_table.setRowCount(len(self.environments))

        # Actualizar el desplegable de entornos en la pestaña de invocación
        prev_env = self.summon_env_combo.currentData()
        self.summon_env_combo.clear()
        self.summon_env_combo.addItem('Aleatoria / todos los entornos', '')

        for row, env in enumerate(self.environments):
            eid_str = str(env['id'])
            self.env_table.setItem(row, 0, QTableWidgetItem(eid_str))
            self.env_table.setItem(row, 1, QTableWidgetItem(env['size']))
            self.env_table.setItem(row, 2, QTableWidgetItem(env['pos']))
            self.env_table.setItem(row, 3, QTableWidgetItem(env['scale']))
            self.env_table.setItem(row, 4, QTableWidgetItem(str(env['mascots'])))
            self.env_table.setItem(row, 5, QTableWidgetItem(env['name'] or env['description'] or '-'))

            label = f"Pantalla #{env['id']} ({env['size']}, {env['mascots']} personajes)"
            self.summon_env_combo.addItem(label, env['id'])

        if prev_env:
            idx = self.summon_env_combo.findData(prev_env)
            if idx >= 0:
                self.summon_env_combo.setCurrentIndex(idx)

    def close_selected_environment(self):
        row = self.env_table.currentRow()
        if row < 0:
            QMessageBox.information(self, 'Aviso', 'Selecciona en la tabla la pantalla cuya capa quieres cerrar.')
            return
        item = self.env_table.item(row, 0)
        if not item:
            return
        eid = item.text().strip()
        if QMessageBox.question(
            self, 'Confirmar',
            f'¿Seguro que quieres cerrar la capa de la pantalla #{eid}?\n(Esto equivale a desconectar esa salida de vídeo; para recuperar la capa será necesario reiniciar el daemon.)'
        ) == QMessageBox.Yes:
            # shimejictl environment close sin -i inicia la selección interactiva;
            # con -i pasa el ID directamente
            self.run_async(['environment', 'close', '-i', eid], f'Cerrando la capa de la pantalla #{eid}...')

    def stop_daemon(self):
        if QMessageBox.question(self, 'Detener servicio', '¿Seguro que quieres detener el daemon de wl_shimeji? Todos los personajes desaparecerán de las pantallas.') == QMessageBox.Yes:
            self.run_async(['stop'], 'Deteniendo el daemon en segundo plano...', callback=lambda rc, _: self.refresh_environments())

    def restart_daemon(self):
        self.status_label.setText('Reiniciando el daemon de wl_shimeji...')
        self.log('$ shimejictl stop && restart')

        def restart_thread():
            run_ctl_sync('stop')
            import time
            time.sleep(1.0)
            run_ctl_sync('environment', 'list')
            QTimer.singleShot(0, lambda: [
                self.status_label.setText('El servicio en segundo plano se ha reiniciado'),
                self.refresh(),
                self.refresh_environments()
            ])

        threading.Thread(target=restart_thread, daemon=True).start()

    def setup_tray(self):
        if not QSystemTrayIcon.isSystemTrayAvailable():
            return
        self.tray = QSystemTrayIcon(QIcon.fromTheme('applications-games'), self)
        self.tray.activated.connect(lambda reason: self.showNormal() if reason == QSystemTrayIcon.Trigger else None)
        self.tray.show()
        self.rebuild_tray()

    def rebuild_tray(self):
        if not hasattr(self, 'tray'):
            return
        menu = QMenu()
        act_open = menu.addAction('Abrir el gestor')
        act_open.triggered.connect(self.showNormal)

        menu.addSeparator()
        summon_menu = menu.addMenu('Invocación rápida')
        for n in self.names:
            act = summon_menu.addAction(n)
            act.triggered.connect(lambda checked=False, name=n: self.run_async(['mascot', 'summon', name], f'{name} invocado'))

        menu.addSeparator()
        act_restore = menu.addAction('Restaurar ventanas capturadas')
        act_restore.triggered.connect(self.restore_windows)

        act_dismiss_one = menu.addAction('Elegir y eliminar uno')
        act_dismiss_one.triggered.connect(lambda: self.run_async(['mascot', 'dismiss', '-s'], 'Esperando a que elijas en pantalla un personaje para eliminar...'))

        act_dismiss_same = menu.addAction('Elegir y eliminar los de su tipo')
        act_dismiss_same.triggered.connect(lambda: self.run_async(['mascot', 'dismiss', '-fs', '-s'], 'Esperando a que elijas en pantalla un personaje para eliminar todos los de su tipo...'))

        act_dismiss_all = menu.addAction('Eliminar todos los personajes')
        act_dismiss_all.triggered.connect(self.dismiss_all)

        menu.addSeparator()
        act_restart = menu.addAction('Reiniciar el servicio de personajes')
        act_restart.triggered.connect(self.restart_daemon)

        act_stop = menu.addAction('Detener el servicio de personajes')
        act_stop.triggered.connect(self.stop_daemon)

        menu.addSeparator()
        act_settings = menu.addAction('Ajustes...')
        act_settings.triggered.connect(lambda: SettingsDialog(self).exec())

        act_quit = menu.addAction('Salir de la interfaz')
        act_quit.triggered.connect(QApplication.instance().quit)

        self.tray.setContextMenu(menu)

    def closeEvent(self, event):
        if hasattr(self, 'tray') and self.tray.isVisible():
            self.hide()
            event.ignore()
        else:
            super().closeEvent(event)


def main():
    if not shutil.which('shimejictl'):
        print('Error: no se encontró el ejecutable shimejictl en PATH.', file=sys.stderr)
        return 1
    app = QApplication(sys.argv)
    app.setApplicationName(APP)
    app.setQuitOnLastWindowClosed(False)
    win = MainWindow()
    win.show()
    return app.exec()


if __name__ == '__main__':
    raise SystemExit(main())
